import random
import os
import time

def vote():
    all_votes = []

    for name in people:
        print(f"Hi {name}")
        choice = input(f"Who do you vote for {people}: ")

        if choice in people:
            all_votes.append(choice)
        else:
            print("ERROR")

    print("Results:")
    for name in people:
        print(f"{name} has {all_votes.count(name)}")
        if name == undercover:
            print(f"{name} is UnderCover")
        elif name == mr_white:
            print(f"{name} is Mr.White")
        else:
            print(f"{name} is Civillian")

def budi():
