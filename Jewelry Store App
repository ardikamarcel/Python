def compare():
    jewelry_8_price = 2000
    jewelry_10_price = 8000
    price_difference = jewelry_10_price - jewelry_8_price
    
    comer = input("Please tell me if you want to compare the price of jewelry 8 and jewelry 10. Say YES if you'd like to, say NO if you wouldn't: ")
    
    if comer.upper() == "YES":
        print(f"Jewelry 8 is ${jewelry_8_price}, jewelry 10 is ${jewelry_10_price}, the difference is ${price_difference}.")
        do()
    elif comer.upper() == "NO":
        print("Bye")
    else:
        print("Please provide a valid answer.")
        compare()

